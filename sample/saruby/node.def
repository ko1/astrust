// saruby — node.def (ASTrust).  Bodies are Rust.
//
// Every dispatcher is   fn(c: &mut Ctx, n: NodePtr, fp: Fp) -> RV
// fp is the current frame on the VM value stack, a slice of slots (src/stack.rs): fp[0] = self,
// fp[1] = env (heap Env for variables captured by blocks, or the outer env), then
// parameters and locals.  Calls stage [recv, -, args...] at sp (`stage`); the callee's
// frame starts there, so arguments land directly in the callee's parameter slots.
//
// Fast paths live here (they get inlined into specialized code); slow paths are
// out-of-line functions in rt.rs.

use crate::vm::*;
use crate::value::*;
use crate::object::*;
use crate::rt::*;
use crate::opt::*;
use crate::node::*;
use crate::compile::{IseqRef, CiRef, Str, LitCache, CallInfo};
use crate::symbol::s;

// ---- literals ---------------------------------------------------------------

NODE_DEF
node_nil(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    Ok(NIL)
}

NODE_DEF
node_true(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    Ok(TRUE)
}

NODE_DEF
node_false(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    Ok(FALSE)
}

NODE_DEF
node_self(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    Ok(fp[0].get())
}

NODE_DEF
node_lit(c: &mut Ctx, n: NodePtr, fp: Fp, v: Value)
{
    Ok(v)
}

NODE_DEF
node_float(c: &mut Ctx, n: NodePtr, fp: Fp, v: f64)
{
    Ok(crate::numeric::float_new(v))
}

NODE_DEF
node_str(c: &mut Ctx, n: NodePtr, fp: Fp, s: Str, enc: u32)
{
    Ok(crate::string::str_new_enc(s, enc as u8))
}

NODE_DEF
node_fstr(c: &mut Ctx, n: NodePtr, fp: Fp, s: Str, enc: u32, lc@ref: LitCache)
{
    if lc.v != 0 { return Ok(unsafe { Value::from_raw(lc.v) }); }
    Ok(srb_fstr(s, enc, lc))
}

NODE_DEF
node_dstr(c: &mut Ctx, n: NodePtr, fp: Fp, parts: NODES, enc: u32, cap: u32)
{
    let acc = crate::string::str_with_capa(cap as usize, enc as u8);
    for i in 0..EVAL_LEN!(parts) {
        let v = EVAL_NTH!(c, parts, i)?;
        srb_dstr_append(c, acc, v)?;
    }
    Ok(acc)
}

NODE_DEF
node_tostr(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value)
{
    if is_string(v) { return Ok(v); }
    srb_tostr(c, v)
}

NODE_DEF
node_dsym(c: &mut Ctx, n: NodePtr, fp: Fp, s@child: Value)
{
    Ok(crate::string::str_to_sym(s))
}

NODE_DEF
node_regex(c: &mut Ctx, n: NodePtr, fp: Fp, src: Str, opts: u32, lc@ref: LitCache)
{
    if lc.v != 0 { return Ok(unsafe { Value::from_raw(lc.v) }); }
    srb_regex_lit(c, src, opts, lc)
}

NODE_DEF
node_dregex(c: &mut Ctx, n: NodePtr, fp: Fp, s@child: Value, opts: u32, once: bool, lc@ref: LitCache)
{
    if once && lc.v != 0 { return Ok(unsafe { Value::from_raw(lc.v) }); }
    srb_dregex(c, s, opts, once, lc)
}

NODE_DEF
node_biglit(c: &mut Ctx, n: NodePtr, fp: Fp, digits: Str, lc@ref: LitCache)
{
    if lc.v != 0 { return Ok(unsafe { Value::from_raw(lc.v) }); }
    Ok(srb_biglit(digits, lc))
}

NODE_DEF
node_ary(c: &mut Ctx, n: NodePtr, fp: Fp, elems: NODES)
{
    let k = EVAL_LEN!(elems);
    // in locals, stored from registers: staged slots are read back with a wide load that stalls on their stores
    if k <= crate::avec::INLINE {
        let x0 = if k > 0 { EVAL_NTH!(c, elems, 0)? } else { NIL };
        let x1 = if k > 1 { EVAL_NTH!(c, elems, 1)? } else { NIL };
        let x2 = if k > 2 { EVAL_NTH!(c, elems, 2)? } else { NIL };
        return Ok(c.ary_new_small(k, [x0, x1, x2]));
    }
    let base = stage(c, k)?;
    for i in 0..k {
        let v = EVAL_NTH!(c, elems, i)?;
        base[i].set(v);
    }
    let a = c.ary_from_slots(&base[0..k]);
    c.set_sp(base, 0);
    Ok(a)
}

// items with kinds: 0 = element, 1 = *splat
NODE_DEF
node_ary_build(c: &mut Ctx, n: NodePtr, fp: Fp, elems: NODES, kinds: Str)
{
    let a = c.ary_new();
    let base = stage(c, 1)?;
    base[0].set(a);
    for i in 0..EVAL_LEN!(elems) {
        let v = EVAL_NTH!(c, elems, i)?;
        if kinds[i] == 1 { srb_splat_into(c, a, v)?; } else { c.ary_push(a, v); }
    }
    c.set_sp(base, 0);
    Ok(a)
}

// pairs: k0 v0 k1 v1 ...; kinds per pair: 0 = pair, 1 = **splat (single node)
NODE_DEF
node_hash(c: &mut Ctx, n: NodePtr, fp: Fp, items: NODES, kinds: Str)
{
    let h = crate::hash::hash_new_capa(kinds.len());
    let base = stage(c, 2)?;
    base[0].set(h);
    let mut i = 0;
    let mut k = 0;
    while i < EVAL_LEN!(items) {
        if kinds[k] == 1 {
            let v = EVAL_NTH!(c, items, i)?;
            srb_hash_merge_kw(c, h, v)?;
            i += 1;
        } else {
            let key = EVAL_NTH!(c, items, i)?;
            base[1].set(key);
            let val = EVAL_NTH!(c, items, i + 1)?;
            crate::hash::hash_aset(c, h, key, val)?;
            i += 2;
        }
        k += 1;
    }
    c.set_sp(base, 0);
    Ok(h)
}

NODE_DEF
node_range(c: &mut Ctx, n: NodePtr, fp: Fp, b@child: Value, e@child: Value, excl: bool)
{
    srb_range_new(c, b, e, excl)
}

NODE_DEF
node_range_lit(c: &mut Ctx, n: NodePtr, fp: Fp, b: Value, e: Value, excl: bool, lc@ref: LitCache)
{
    if lc.v != 0 { return Ok(unsafe { Value::from_raw(lc.v) }); }
    Ok(srb_range_lit(b, e, excl, lc))
}

// ---- variables ----------------------------------------------------------------

NODE_DEF
node_lvar(c: &mut Ctx, n: NodePtr, fp: Fp, idx: u32)
{
    Ok(slot(fp, idx).get())
}

NODE_DEF
node_lasgn(c: &mut Ctx, n: NodePtr, fp: Fp, idx: u32, v@child: Value)
{
    slot(fp, idx).set(v);
    Ok(v)
}

NODE_DEF
node_dvar(c: &mut Ctx, n: NodePtr, fp: Fp, hops: u32, idx: u32)
{
    let env = env_at(fp[1].get(), hops);
    Ok(env_get(env, idx))
}

NODE_DEF
node_dasgn(c: &mut Ctx, n: NodePtr, fp: Fp, hops: u32, idx: u32, v@child: Value)
{
    let env = env_at(fp[1].get(), hops);
    env_set(env, idx, v);
    Ok(v)
}

// slot (baked): 1 + the index the site's cache held, 0 none.  Baked code tests it against the cache,
// so which tier holds the slot is known there; a stale one only sends the site out of line.
NODE_DEF
node_ivar(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, ic@ref: IvarCache, slot@bake: u32)
{
    let slf = fp[0].get();
    if slf.is_heap() {
        let o = obj(slf);
        if o.klass.raw() == ic.klass {
            if let Body::Object(ivs) = &o.body {
                if slot == 0 {
                    if let Some(v) = ivs.get(ic.idx as usize) { return Ok(if v == UNDEF { NIL } else { v }); }
                    return Ok(NIL);
                } else if ic.idx == slot - 1 {
                    // an unset slot leaves through the miss path (a branch to code the site already has, not a select)
                    if let Some(v) = ivs.get((slot - 1) as usize) { if v != UNDEF { return Ok(v); } }
                }
            }
        }
    }
    Ok(srb_ivar_get_out(slf, name, ic))
}

NODE_DEF
node_iasgn(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, v@child: Value, ic@ref: IvarCache, slot@bake: u32)
{
    let slf = fp[0].get();
    if slf.is_heap() {
        let o = obj(slf);
        if o.klass.raw() == ic.klass && o.flags & FL_FROZEN == 0 {
            if let Body::Object(ivs) = &mut o.body {
                if slot == 0 { if ivs.set(ic.idx as usize, v) { return Ok(v); } }
                else if ic.idx == slot - 1 && ivs.set((slot - 1) as usize, v) { return Ok(v); }
            }
        }
    }
    srb_ivar_set_out(c, slf, name, v, ic)
}

// `@x += v` / `@x -= v` with a v that cannot change @x (compile.rs): one self / class / slot test for the
// read and the write, fixnums inline.
NODE_DEF
node_ivar_arith(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, sub: bool, v@child: Value, line: u32, ic@ref: IvarCache, cc@ref: CallCache, slot@bake: u32)
{
    let slf = fp[0].get();
    if slf.is_heap() && v.is_fixnum() && !redef(if sub { R_INT_MINUS } else { R_INT_PLUS }) {
        let o = obj(slf);
        if o.klass.raw() == ic.klass && o.flags & FL_FROZEN == 0 && (slot == 0 || ic.idx == slot - 1) {
            if let Body::Object(ivs) = &mut o.body {
                let i = (if slot == 0 { ic.idx } else { slot - 1 }) as usize;
                if let Some(cur) = ivs.get(i) {
                    if cur.is_fixnum() {
                        if let Some(r) = if sub { cur.fix_sub(v) } else { cur.fix_add(v) } { ivs.set(i, r); return Ok(r); }
                    }
                }
            }
        }
    }
    srb_ivar_arith_out(c, slf, name, sub, v, line, ic, cc)
}

NODE_DEF
node_gvar(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym)
{
    srb_gvar_get(c, name)
}

NODE_DEF
node_gasgn(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, v@child: Value)
{
    srb_gvar_set(c, name, v)
}

NODE_DEF
node_cvar(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym)
{
    srb_cvar_get(c, name)
}

NODE_DEF
node_cvasgn(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, v@child: Value)
{
    srb_cvar_set(c, name, v)
}

NODE_DEF
node_const(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, line: u32, cc@ref: ConstCache)
{
    let cref = unsafe { (*c.frame).cref() };
    if cc.serial == vm().const_serial && cc.cref == cref as usize { return Ok(unsafe { Value::from_raw(cc.val) }); }
    unsafe { (*c.frame).line = line; }
    srb_const_get(c, cref, name, cc)
}

NODE_DEF
node_const_path(c: &mut Ctx, n: NodePtr, fp: Fp, parent@child: Value, name: Sym, line: u32)
{
    unsafe { (*c.frame).line = line; }
    srb_const_path(c, parent, name)
}

NODE_DEF
node_top_const(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym)
{
    srb_const_path(c, vm().c_object, name)
}

NODE_DEF
node_cdecl(c: &mut Ctx, n: NodePtr, fp: Fp, name: Sym, v@child: Value)
{
    srb_cdecl(c, NIL, name, v)
}

NODE_DEF
node_cdecl_path(c: &mut Ctx, n: NodePtr, fp: Fp, parent@child: Value, name: Sym, v@child: Value)
{
    srb_cdecl_path(c, parent, name, v)
}

NODE_DEF
node_errinfo(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    Ok(c.errinfo)
}

NODE_DEF
node_nth_ref(c: &mut Ctx, n: NodePtr, fp: Fp, nth: u32)
{
    Ok(crate::regexp::nth_match(c.last_match, nth as i64))
}

NODE_DEF
node_back_ref(c: &mut Ctx, n: NodePtr, fp: Fp, kind: u32)
{
    srb_back_ref(c, kind)
}

// ---- control flow -----------------------------------------------------------

NODE_DEF
node_block(c: &mut Ctx, n: NodePtr, fp: Fp, stmts: NODES)
{
    // unrolled by hand: a loop over nth() stays a loop + switch in specialized code
    let k = EVAL_LEN!(stmts);
    if k > 1 { EVAL_NTH!(c, stmts, 0)?; }
    if k > 2 { EVAL_NTH!(c, stmts, 1)?; }
    if k > 3 { EVAL_NTH!(c, stmts, 2)?; }
    if k > 4 { EVAL_NTH!(c, stmts, 3)?; }
    if k > 5 { EVAL_NTH!(c, stmts, 4)?; }
    if k > 6 { EVAL_NTH!(c, stmts, 5)?; }
    if k > 7 { EVAL_NTH!(c, stmts, 6)?; }
    let mut i = 7;
    while i + 1 < k { EVAL_NTH!(c, stmts, i)?; i += 1; }
    EVAL_NTH!(c, stmts, k - 1)
}

NODE_DEF
node_line(c: &mut Ctx, n: NodePtr, fp: Fp, line: u32, body: NODE)
{
    unsafe { (*c.frame).line = line; }
    EVAL_ARG!(c, body)
}

NODE_DEF
node_if(c: &mut Ctx, n: NodePtr, fp: Fp, cond: NODE, then_b: NODE, else_b: NODE)
{
    if EVAL_TEST!(c, cond)? { EVAL_ARG!(c, then_b) } else { EVAL_ARG!(c, else_b) }
}

NODE_DEF
node_and(c: &mut Ctx, n: NodePtr, fp: Fp, a: NODE, b: NODE)
{
    let v = EVAL_ARG!(c, a)?;
    if v.falsy() { Ok(v) } else { EVAL_ARG!(c, b) }
}
NODE_TEST
{
    if EVAL_TEST!(c, a)? { EVAL_TEST!(c, b) } else { Ok(false) }
}

NODE_DEF
node_or(c: &mut Ctx, n: NodePtr, fp: Fp, a: NODE, b: NODE)
{
    let v = EVAL_ARG!(c, a)?;
    if v.truthy() { Ok(v) } else { EVAL_ARG!(c, b) }
}
NODE_TEST
{
    if EVAL_TEST!(c, a)? { Ok(true) } else { EVAL_TEST!(c, b) }
}

NODE_DEF
node_not(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value, cc@ref: CallCache)
{
    if v.is_heap() && srb_has_custom_not(v) { return srb_call0(c, v, s::not, cc); }
    Ok(Value::bool(v.falsy()))
}
NODE_TEST
{
    if v.is_heap() && srb_has_custom_not(v) { return Ok(srb_call0(c, v, s::not, cc)?.truthy()); }
    Ok(v.falsy())
}

NODE_DEF
node_while(c: &mut Ctx, n: NodePtr, fp: Fp, cond: NODE, body: NODE, until: bool)
{
    loop {
        let t = EVAL_TEST!(c, cond)?;
        if t == until { break; }
        loop {
            match EVAL_ARG!(c, body) {
                Ok(_) => break,
                Err(e) => match c.esc {
                    EscKind::LoopNext => { c.esc = EscKind::None; break; }
                    EscKind::LoopBreak => { c.esc = EscKind::None; return Ok(c.esc_val); }
                    EscKind::Redo => { c.esc = EscKind::None; }
                    _ => return Err(e),
                }
            }
        }
    }
    Ok(NIL)
}

NODE_DEF
node_dowhile(c: &mut Ctx, n: NodePtr, fp: Fp, cond: NODE, body: NODE, until: bool)
{
    loop {
        match EVAL_ARG!(c, body) {
            Ok(_) => {}
            Err(e) => match c.esc {
                EscKind::LoopNext => { c.esc = EscKind::None; }
                EscKind::LoopBreak => { c.esc = EscKind::None; return Ok(c.esc_val); }
                _ => return Err(e),
            }
        }
        let t = EVAL_TEST!(c, cond)?;
        if t == until { break; }
    }
    Ok(NIL)
}

NODE_DEF
node_loop_break(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value)
{
    c.esc = EscKind::LoopBreak;
    c.esc_val = v;
    Err(Esc)
}

NODE_DEF
node_loop_next(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value)
{
    c.esc = EscKind::LoopNext;
    c.esc_val = v;
    Err(Esc)
}

NODE_DEF
node_break(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value)
{
    srb_break(c, v)
}

NODE_DEF
node_next(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value)
{
    c.esc = EscKind::Next;
    c.esc_val = v;
    Err(Esc)
}

NODE_DEF
node_return(c: &mut Ctx, n: NodePtr, fp: Fp, v@child: Value)
{
    if unsafe { (*c.frame).kind } == FK_BLOCK { return srb_block_return(c, v); }
    c.esc = EscKind::Return;
    c.esc_val = v;
    c.esc_tag = unsafe { (*c.frame).id };
    Err(Esc)
}

NODE_DEF
node_retry(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    c.esc = EscKind::Retry;
    c.esc_val = NIL;
    Err(Esc)
}

NODE_DEF
node_redo(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    c.esc = EscKind::Redo;
    c.esc_val = NIL;
    Err(Esc)
}

// begin/rescue: clauses are node_resbody, which answer UNDEF when they do not match
NODE_DEF
node_rescue(c: &mut Ctx, n: NodePtr, fp: Fp, body: NODE, clauses: NODES, else_b: NODE, has_else: bool)
{
    let saved_sp = c.sp_mark();
    let saved_err = c.errinfo;
    loop {
        match EVAL_ARG!(c, body) {
            Ok(v) => { return if has_else { EVAL_ARG!(c, else_b) } else { Ok(v) }; }
            Err(e) => {
                if c.esc != EscKind::Raise { return Err(e); }
                c.sp_reset(saved_sp);
                let exc = c.esc_val;
                if !srb_rescuable(exc) { return Err(e); }
                c.esc = EscKind::None;
                c.errinfo = exc;
                let mut matched = false;
                let mut result = Ok(NIL);
                for i in 0..EVAL_LEN!(clauses) {
                    let r = EVAL_NTH!(c, clauses, i);
                    match r {
                        Ok(v) if v == UNDEF => continue,
                        other => { matched = true; result = other; break; }
                    }
                }
                if !matched {
                    c.errinfo = saved_err;
                    c.esc = EscKind::Raise;
                    c.esc_val = exc;
                    return Err(e);
                }
                if result.is_err() && c.esc == EscKind::Retry { c.esc = EscKind::None; c.errinfo = saved_err; continue; }
                if result.is_ok() { c.errinfo = saved_err; }
                return result;
            }
        }
    }
}

// matches: list of class expressions (empty = StandardError); splats flagged in kinds
NODE_DEF
node_resbody(c: &mut Ctx, n: NodePtr, fp: Fp, classes: NODES, kinds: Str, assign: NODE, body: NODE)
{
    let exc = c.errinfo;
    let mut ok = EVAL_LEN!(classes) == 0 && srb_is_standard_error(exc);
    let mut i = 0;
    while !ok && i < EVAL_LEN!(classes) {
        let k = EVAL_NTH!(c, classes, i)?;
        ok = srb_rescue_match(c, k, exc, kinds[i] == 1)?;
        i += 1;
    }
    if !ok { return Ok(UNDEF); }
    EVAL_ARG!(c, assign)?;
    EVAL_ARG!(c, body)
}

NODE_DEF
node_ensure(c: &mut Ctx, n: NodePtr, fp: Fp, body: NODE, ens: NODE)
{
    let r = EVAL_ARG!(c, body);
    let (k, v, t, tv) = (c.esc, c.esc_val, c.esc_tag, c.esc_tag_v);
    let saved_err = c.errinfo;
    if r.is_err() && k == EscKind::Raise { c.errinfo = v; }
    c.esc = EscKind::None;
    EVAL_ARG!(c, ens)?;
    c.errinfo = saved_err;
    c.esc = k; c.esc_val = v; c.esc_tag = t; c.esc_tag_v = tv;
    r
}

// case/when: one `when` clause's test against the subject in a hidden local
NODE_DEF
node_when(c: &mut Ctx, n: NodePtr, fp: Fp, subj_slot: u32, pats: NODES, kinds: Str, cc@ref: CallCache, km@ref: KindMemo)
{
    let subj = slot(fp, subj_slot).get();
    for i in 0..EVAL_LEN!(pats) {
        let p = EVAL_NTH!(c, pats, i)?;
        if kinds[i] == 1 {
            if srb_when_splat(c, p, subj)? { return Ok(TRUE); }
        } else {
            let hit = match eqq_imm(p, subj) {
                Some(b) => b,
                None => {
                    // Module#=== asked of the same subject class again: d is 0 (no) or 1 (yes)
                    let k = class_of(subj).raw();
                    let d = km.memo[kind_way(k)] ^ k;
                    // is_class: the slot of a dead pattern class may be another object by now (a new class would move the serial)
                    if p.raw() == km.pat && d <= 1 && km.ser == kind_serial() && is_class_or_module(p) { d == 1 } else { srb_eqq_class(c, p, subj, cc, km)? }
                }
            };
            if hit { return Ok(TRUE); }
        }
    }
    Ok(FALSE)
}

// `when LIT` for one immediate literal (Integer / Symbol / nil / true / false)
NODE_DEF
node_when_lit(c: &mut Ctx, n: NodePtr, fp: Fp, subj_slot: u32, v: Value, cc@ref: CallCache)
{
    let subj = slot(fp, subj_slot).get();
    if subj == v { return Ok(TRUE); }
    if !v.is_fixnum() || subj.is_fixnum() { return Ok(FALSE); }
    Ok(Value::bool(srb_eqq(c, v, subj, cc)?))
}

NODE_DEF
node_defined(c: &mut Ctx, n: NodePtr, fp: Fp, kind: u32, name: Sym, recv: NODE)
{
    srb_defined::<D_recv>(c, n, fp, kind, name, recv)
}

// ---- calls ----------------------------------------------------------------------

NODE_DEF
node_call(c: &mut Ctx, n: NodePtr, fp: Fp, recv: NODE, args: NODES, mid: Sym, flags: u32, line: u32, cc@ref: CallCache, callee@spec: NODE, kind@bake: u32, shared@bake: u32)
{
    // baked self call of a callee without parameters, locals, env or block literal: it runs in this frame
    if shared != 0 && SPEC_HASH!(callee) != 0 {
        let r0 = fp[0].get();
        if spec_hit(cc, r0, kind) {
            if shared == 1 { unsafe { (*c.frame).line = line; } }
            return EVAL_SPEC!(c, callee, cc.fast as NodePtr, fp, CallArgs { me: cc.me as *const MethodEntry, blk: std::ptr::null(), shared: true });
        }
    }
    let k = EVAL_LEN!(args);
    let base = stage(c, 2 + k)?;
    let r0 = EVAL_ARG!(c, recv)?;
    base[0].set(r0);
    for i in 0..k { let v = EVAL_NTH!(c, args, i)?; base[2 + i].set(v); }
    unsafe { (*c.frame).line = line; }
    // with arguments in between, reading the slot back is cheaper than keeping the receiver live
    let r0 = if k == 0 { r0 } else { base[0].get() };
    if kind == SITE_INTERP { return call_cached(c, cc, mid, base, k as u32, std::ptr::null(), flags); }
    // baked code: one cache test, then the callee compiled into this site or the site's one fast path
    if SPEC_HASH!(callee) != 0 {
        // spec_klass is set only while the cache holds the compiled-in callee (a shared site tested it above)
        if shared == 0 && spec_hit(cc, r0, kind) {
            // sp is where stage() left it: what the entry expects
            let callee_fp = frame(c, base)?;
            let r = EVAL_SPEC!(c, callee, cc.fast as NodePtr, callee_fp, CallArgs::new(cc.me as *const MethodEntry, std::ptr::null()));
            c.set_sp(base, 0);
            return r;
        }
        return call_spec_out(c, cc, mid, base, k as u32, std::ptr::null(), flags, SPEC_HASH!(callee));
    }
    if site_hit(cc, r0, kind) {
        if let Some(r) = site_fast(c, cc, r0, base, k as u32, std::ptr::null(), kind) { return r; }
    }
    call_cached_out(c, cc, mid, base, k as u32, std::ptr::null(), flags)
}

NODE_DEF
node_call_blk(c: &mut Ctx, n: NodePtr, fp: Fp, recv: NODE, args: NODES, mid: Sym, flags: u32, line: u32, blk: IseqRef, cc@ref: CallCache, callee@spec: NODE, kind@bake: u32)
{
    let k = EVAL_LEN!(args);
    let base = stage(c, 2 + k)?;
    let r0 = EVAL_ARG!(c, recv)?;
    base[0].set(r0);
    for i in 0..k { let v = EVAL_NTH!(c, args, i)?; base[2 + i].set(v); }
    unsafe { (*c.frame).line = line; }
    // with arguments in between, reading the slot back is cheaper than keeping the receiver live
    let r0 = if k == 0 { r0 } else { base[0].get() };
    let b = make_block(c, blk, fp);
    let r = if kind == SITE_INTERP { call_cached(c, cc, mid, base, k as u32, &b, flags) }
    else if SPEC_HASH!(callee) != 0 {
        if spec_hit(cc, r0, kind) {
            let callee_fp = frame(c, base)?;
            let r = EVAL_SPEC!(c, callee, cc.fast as NodePtr, callee_fp, CallArgs::new(cc.me as *const MethodEntry, &b));
            c.set_sp(base, 0);
            r
        } else { call_spec_out(c, cc, mid, base, k as u32, &b, flags, SPEC_HASH!(callee)) }
    } else if site_hit(cc, r0, kind) && SPEC_HASH!(callee) == 0 {
        match site_fast(c, cc, r0, base, k as u32, &b, kind) { Some(r) => r, None => call_cached_out(c, cc, mid, base, k as u32, &b, flags) }
    } else { call_cached_out(c, cc, mid, base, k as u32, &b, flags) };
    match r {
        Err(e) if c.esc == EscKind::Break && c.esc_tag == b.tag => { c.esc = EscKind::None; Ok(c.esc_val) }
        r => r,
    }
}

// f(args..., k: v, ...) with literal symbol keywords: values staged after the positionals
NODE_DEF
node_call_kw(c: &mut Ctx, n: NodePtr, fp: Fp, recv: NODE, args: NODES, mid: Sym, flags: u32, line: u32, ci: CiRef, cc@ref: CallCache)
{
    let k = EVAL_LEN!(args);
    let base = stage(c, 3 + k)?;
    base[0].set(EVAL_ARG!(c, recv)?);
    for i in 0..k { let v = EVAL_NTH!(c, args, i)?; base[2 + i].set(v); }
    unsafe { (*c.frame).line = line; }
    srb_call_kw(c, cc, mid, base, k, ci, flags, fp)
}

// general call: splats, keywords, block-pass (described by ci)
NODE_DEF
node_call_x(c: &mut Ctx, n: NodePtr, fp: Fp, recv: NODE, args: NODES, mid: Sym, flags: u32, line: u32, ci: CiRef, cc@ref: CallCache)
{
    let base = stage(c, 2)?;
    let r0 = EVAL_ARG!(c, recv)?;
    base[0].set(r0);
    let tmp = crate::array::ary_new();
    base[1].set(tmp);
    let mut blkv = NIL;
    let mut kw = NIL;
    for i in 0..EVAL_LEN!(args) {
        let v = EVAL_NTH!(c, args, i)?;
        srb_callx_arg(c, ci, i, v, tmp, &mut kw, &mut blkv)?;
    }
    unsafe { (*c.frame).line = line; }
    srb_call_x(c, cc, mid, base, tmp, kw, blkv, ci, flags, fp)
}

NODE_DEF
node_attrasgn(c: &mut Ctx, n: NodePtr, fp: Fp, recv: NODE, args: NODES, mid: Sym, flags: u32, line: u32, cc@ref: CallCache, kind@bake: u32)
{
    let k = EVAL_LEN!(args);
    let base = stage(c, 2 + k)?;
    base[0].set(EVAL_ARG!(c, recv)?);
    for i in 0..k { let v = EVAL_NTH!(c, args, i)?; base[2 + i].set(v); }
    unsafe { (*c.frame).line = line; }
    let val = base[1 + k].get();
    if kind == SITE_INTERP { call_cached(c, cc, mid, base, k as u32, std::ptr::null(), flags)?; return Ok(val); }
    // baked code: only the site's one fast path inline, as node_call
    let r0 = base[0].get();
    if site_hit(cc, r0, kind) {
        if let Some(r) = site_fast(c, cc, r0, base, k as u32, std::ptr::null(), kind) { r?; return Ok(val); }
    }
    call_cached_out(c, cc, mid, base, k as u32, std::ptr::null(), flags)?;
    Ok(val)
}

NODE_DEF
node_super(c: &mut Ctx, n: NodePtr, fp: Fp, args: NODES, line: u32, ci: CiRef, zsuper: bool)
{
    let base = stage(c, 2)?;
    let tmp = crate::array::ary_new();
    base[0].set(fp[0].get()); base[1].set(tmp);
    let mut blkv = NIL;
    let mut kw = NIL;
    for i in 0..EVAL_LEN!(args) {
        let v = EVAL_NTH!(c, args, i)?;
        srb_callx_arg(c, ci, i, v, tmp, &mut kw, &mut blkv)?;
    }
    unsafe { (*c.frame).line = line; }
    srb_super(c, base, tmp, kw, blkv, ci, fp, zsuper)
}

NODE_DEF
node_yield(c: &mut Ctx, n: NodePtr, fp: Fp, args: NODES, yc@ref: YieldCache, callee@spec: NODE, np@bake: u32)
{
    let k = EVAL_LEN!(args);
    let blk = unsafe { (*c.frame).blk };
    if blk.is_null() { return srb_no_block(c); }
    let base = stage(c, 2 + k)?;
    for i in 0..k { let v = EVAL_NTH!(c, args, i)?; base[2 + i].set(v); }
    if SPEC_HASH!(callee) == 0 { srb_yield_note(yc, blk); return srb_yield_staged(c, blk, base, k as u32); }
    // baked, one block seen: its entry compiled in, guarded by the iseq (yc.fast is set once its hash matched)
    let b = unsafe { &*blk };
    if let BlockKind::Iseq(is) = b.kind {
        if is as usize == yc.fast && (b.proc_val == UNDEF || !rproc(b.proc_val).is_lambda) {
            // np = 1 + the block's lead parameter count: missing arguments are nil
            if (k as u32) + 1 < np { nil_fill(base, 2 + k, 1 + np as usize); }
            c.set_sp(base, 0);
            let bfp = frame(c, base)?;
            let r = EVAL_SPEC!(c, callee, unsafe { (*is).bentry }, bfp, CallArgs::new(std::ptr::null(), blk));
            c.set_sp(base, 0);
            return r;
        }
    }
    srb_yield_miss(c, yc, SPEC_HASH!(callee), blk, base, k as u32)
}

NODE_DEF
node_yield_x(c: &mut Ctx, n: NodePtr, fp: Fp, args: NODES, ci: CiRef)
{
    let tmp = crate::array::ary_new();
    let base = stage(c, 1)?;
    base[0].set(tmp);
    let mut blkv = NIL;
    let mut kw = NIL;
    for i in 0..EVAL_LEN!(args) {
        let v = EVAL_NTH!(c, args, i)?;
        srb_callx_arg(c, ci, i, v, tmp, &mut kw, &mut blkv)?;
    }
    let r = srb_yield_x(c, tmp, kw);
    c.set_sp(base, 0);
    r
}

NODE_DEF
node_block_given(c: &mut Ctx, n: NodePtr, fp: Fp)
{
    Ok(Value::bool(unsafe { !(*c.frame).blk.is_null() }))
}

NODE_DEF
node_lambda(c: &mut Ctx, n: NodePtr, fp: Fp, blk: IseqRef)
{
    srb_lambda(c, blk, fp)
}

// ---- specialized operators (fixnum / float fast paths) ---------------------------------

// ty (baked): 1 + what the site's operands were besides fixnums (TyFb, recorded by the interpreter), 0 in the
// interpreter.  Baked code keeps the Float paths inline only where Floats were seen; the rest is srb_arith_out.
NODE_DEF
node_opt_plus(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_PLUS) { if let Some(r) = a.fix_add(b) { return Ok(r); } }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2(a, b, R_FLO_PLUS, R_INT_PLUS) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(crate::numeric::float_new(x + y)); }
        return srb_binop(c, a, b, s::plus, line, cc);
    }
    srb_arith_out(c, a, b, s::plus, line, cc)
}

NODE_DEF
node_opt_minus(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_MINUS) { if let Some(r) = a.fix_sub(b) { return Ok(r); } }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2(a, b, R_FLO_MINUS, R_INT_MINUS) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(crate::numeric::float_new(x - y)); }
        return srb_binop(c, a, b, s::minus, line, cc);
    }
    srb_arith_out(c, a, b, s::minus, line, cc)
}

NODE_DEF
node_opt_mul(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_MUL) { if let Some(r) = a.fix_mul(b) { return Ok(r); } }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2(a, b, R_FLO_MUL, R_INT_MUL) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(crate::numeric::float_new(x * y)); }
        return srb_binop(c, a, b, s::mul, line, cc);
    }
    srb_arith_out(c, a, b, s::mul, line, cc)
}

NODE_DEF
node_opt_div(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.is_fixnum() && b.is_fixnum() && b.as_fix() != 0 && !redef(R_INT_DIV) {
        let (x, y) = (a.as_fix(), b.as_fix());
        let q = if (x % y != 0) && ((x < 0) != (y < 0)) { x / y - 1 } else { x / y };
        if Value::fixable(q) { return Ok(Value::fix(q)); }
    }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2(a, b, R_FLO_DIV, R_INT_DIV) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(crate::numeric::float_new(x / y)); }
        return srb_binop(c, a, b, s::div, line, cc);
    }
    srb_arith_out(c, a, b, s::div, line, cc)
}

// Float ** Float with a non-negative base (a negative one may give a Complex)
NODE_DEF
node_opt_pow(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_flonum() && b.is_flonum() && !redef(R_FLO_POW) {
        let (x, y) = (a.flonum_val(), b.flonum_val());
        if x >= 0.0 { return Ok(crate::numeric::float_new(crate::numeric::libm_pow(x, y))); }
    }
    srb_binop(c, a, b, s::pow, line, cc)
}

NODE_DEF
node_opt_mod(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_fixnum() && b.is_fixnum() && b.as_fix() != 0 && !redef(R_INT_MOD) {
        let (x, y) = (a.as_fix(), b.as_fix());
        let m = x % y;
        let m = if m != 0 && ((m < 0) != (y < 0)) { m + y } else { m };
        return Ok(Value::fix(m));
    }
    srb_binop(c, a, b, s::modulo, line, cc)
}

NODE_DEF
node_opt_lt(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_LT) { return Ok(Value::bool(a.fix_ord() < b.fix_ord())); }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2_cmp(a, b, R_FLO_LT, R_INT_LT) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(Value::bool(x < y)); }
        return srb_binop(c, a, b, s::lt, line, cc);
    }
    srb_arith_out(c, a, b, s::lt, line, cc)
}
NODE_TEST
{
    if a.both_fix(b) && !redef(R_INT_LT) { return Ok(a.fix_ord() < b.fix_ord()); }
    if tf_flo(ty) {
        if a.is_flonum() && b.is_flonum() && !redef(R_FLO_LT) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(a.flonum_val() < b.flonum_val()); }
        if ty == 0 { return Ok(srb_binop(c, a, b, s::lt, line, cc)?.truthy()); }
    }
    Ok(srb_arith_out(c, a, b, s::lt, line, cc)?.truthy())
}

NODE_DEF
node_opt_le(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_LE) { return Ok(Value::bool(a.fix_ord() <= b.fix_ord())); }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2_cmp(a, b, R_FLO_LE, R_INT_LE) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(Value::bool(x <= y)); }
        return srb_binop(c, a, b, s::le, line, cc);
    }
    srb_arith_out(c, a, b, s::le, line, cc)
}
NODE_TEST
{
    if a.both_fix(b) && !redef(R_INT_LE) { return Ok(a.fix_ord() <= b.fix_ord()); }
    if tf_flo(ty) {
        if a.is_flonum() && b.is_flonum() && !redef(R_FLO_LE) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(a.flonum_val() <= b.flonum_val()); }
        if ty == 0 { return Ok(srb_binop(c, a, b, s::le, line, cc)?.truthy()); }
    }
    Ok(srb_arith_out(c, a, b, s::le, line, cc)?.truthy())
}

NODE_DEF
node_opt_gt(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_GT) { return Ok(Value::bool(a.fix_ord() > b.fix_ord())); }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2_cmp(a, b, R_FLO_GT, R_INT_GT) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(Value::bool(x > y)); }
        return srb_binop(c, a, b, s::gt, line, cc);
    }
    srb_arith_out(c, a, b, s::gt, line, cc)
}
NODE_TEST
{
    if a.both_fix(b) && !redef(R_INT_GT) { return Ok(a.fix_ord() > b.fix_ord()); }
    if tf_flo(ty) {
        if a.is_flonum() && b.is_flonum() && !redef(R_FLO_GT) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(a.flonum_val() > b.flonum_val()); }
        if ty == 0 { return Ok(srb_binop(c, a, b, s::gt, line, cc)?.truthy()); }
    }
    Ok(srb_arith_out(c, a, b, s::gt, line, cc)?.truthy())
}

NODE_DEF
node_opt_ge(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_GE) { return Ok(Value::bool(a.fix_ord() >= b.fix_ord())); }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2_cmp(a, b, R_FLO_GE, R_INT_GE) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(Value::bool(x >= y)); }
        return srb_binop(c, a, b, s::ge, line, cc);
    }
    srb_arith_out(c, a, b, s::ge, line, cc)
}
NODE_TEST
{
    if a.both_fix(b) && !redef(R_INT_GE) { return Ok(a.fix_ord() >= b.fix_ord()); }
    if tf_flo(ty) {
        if a.is_flonum() && b.is_flonum() && !redef(R_FLO_GE) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(a.flonum_val() >= b.flonum_val()); }
        if ty == 0 { return Ok(srb_binop(c, a, b, s::ge, line, cc)?.truthy()); }
    }
    Ok(srb_arith_out(c, a, b, s::ge, line, cc)?.truthy())
}

NODE_DEF
node_opt_eq(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_EQ) { return Ok(Value::bool(a == b)); }
    if tf_flo(ty) { if let Some((x, y)) = flo2_cmp(a, b, R_FLO_EQ, R_INT_EQ) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(Value::bool(x == y)); } }
    // nil / true / false / Symbol receivers: == is identity
    if a.is_special() && !redef(R_IMM_EQ) { return Ok(Value::bool(a == b)); }
    if ty == 0 { return srb_eq(c, a, b, line, cc); }
    srb_arith_out(c, a, b, s::eq, line, cc)
}
NODE_TEST
{
    if a.both_fix(b) && !redef(R_INT_EQ) { return Ok(a == b); }
    if tf_flo(ty) { if a.is_flonum() && b.is_flonum() && !redef(R_FLO_EQ) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(a.flonum_val() == b.flonum_val()); } }
    if a.is_sym() && b.is_sym() { return Ok(a == b); }
    if ty == 0 { return Ok(srb_eq(c, a, b, line, cc)?.truthy()); }
    Ok(srb_arith_out(c, a, b, s::eq, line, cc)?.truthy())
}

NODE_DEF
node_opt_neq(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.both_fix(b) && !redef(R_INT_EQ) { return Ok(Value::bool(a != b)); }
    if tf_flo(ty) {
        if let Some((x, y)) = flo2_cmp(a, b, R_FLO_EQ, R_INT_EQ) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(Value::bool(x != y)); }
        return srb_binop(c, a, b, s::neq, line, cc);
    }
    srb_arith_out(c, a, b, s::neq, line, cc)
}
NODE_TEST
{
    if a.both_fix(b) && !redef(R_INT_EQ) { return Ok(a != b); }
    if tf_flo(ty) {
        if a.is_flonum() && b.is_flonum() && !redef(R_FLO_EQ) { if ty == 0 { tf.0 |= TF_FLO; } return Ok(a.flonum_val() != b.flonum_val()); }
        if ty == 0 { return Ok(srb_binop(c, a, b, s::neq, line, cc)?.truthy()); }
    }
    Ok(srb_arith_out(c, a, b, s::neq, line, cc)?.truthy())
}

NODE_DEF
node_opt_ltlt(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_LSHIFT) {
        let (x, k) = (a.as_fix(), b.as_fix());
        if (0..62).contains(&k) { let r = (x as i128) << k; if r >= FIXNUM_MIN as i128 && r <= FIXNUM_MAX as i128 { return Ok(Value::fix(r as i64)); } }
    }
    if is_array(a) && !redef(R_ARY_LTLT) && obj(a).flags & FL_FROZEN == 0 && obj(a).klass == vm().c_array {
        c.ary_push(a, b);
        return Ok(a);
    }
    if is_string(a) && is_string(b) && obj(a).klass == vm().c_string && !redef(R_STR_LTLT) {
        if obj(a).flags & FL_FROZEN == 0 && rstr(a).enc == rstr(b).enc {
            crate::string::str_append_same_enc(a, b);
            return Ok(a);
        }
        unsafe { (*c.frame).line = line; }
        crate::string::str_append_str(c, a, b)?;
        return Ok(a);
    }
    srb_binop(c, a, b, s::ltlt, line, cc)
}

NODE_DEF
node_opt_gtgt(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_RSHIFT) {
        let k = b.as_fix();
        if k >= 0 { return Ok(Value::fix(if k >= 63 { if a.as_fix() < 0 { -1 } else { 0 } } else { a.as_fix() >> k })); }
    }
    srb_binop(c, a, b, s::gtgt, line, cc)
}

NODE_DEF
node_opt_xor(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_XOR) { return Ok(Value::fix(a.as_fix() ^ b.as_fix())); }
    srb_binop(c, a, b, s::xor, line, cc)
}

NODE_DEF
node_opt_and(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_AND) { return Ok(Value::fix(a.as_fix() & b.as_fix())); }
    srb_binop(c, a, b, s::and, line, cc)
}

NODE_DEF
node_opt_or(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache)
{
    if a.is_fixnum() && b.is_fixnum() && !redef(R_INT_OR) { return Ok(Value::fix(a.as_fix() | b.as_fix())); }
    srb_binop(c, a, b, s::or, line, cc)
}

// An Array indexed by an Integer in range is inline (fast_ary_*: the class and the redefinition in one
// compare).  A Hash stays inline in the interpreter and at baked sites that saw one (TF_HASH).
NODE_DEF
node_opt_aref(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    // the class load sits between the two tag tests, or they are merged into setcc / or
    if a.is_heap() && obj(a).klass.raw() == fast_ary_aref() && b.is_fixnum() {
        if let Some(&x) = c.ary(a).get(b.as_fix() as usize) { return Ok(x); }
    } else if tf_hash(ty) && is_hash(a) && obj(a).klass == vm().c_hash && !redef(R_HASH_AREF) {
        if ty == 0 { tf.0 |= TF_HASH; }
        return crate::hash::hash_aref(c, a, b);
    }
    srb_aref_out(c, a, b, line, cc)
}

NODE_DEF
node_opt_aset(c: &mut Ctx, n: NodePtr, fp: Fp, a@child: Value, b@child: Value, v@child: Value, line: u32, cc@ref: CallCache, tf@ref: TyFb, ty@bake: u32)
{
    if a.is_heap() && obj(a).klass.raw() == fast_ary_aset() && b.is_fixnum() && obj(a).flags & FL_FROZEN == 0 {
        if let Some(x) = c.ary_mut(a).get_mut(b.as_fix() as usize) { *x = v; return Ok(v); }
    } else if tf_hash(ty) && is_hash(a) && obj(a).klass == vm().c_hash && !redef(R_HASH_ASET) {
        if ty == 0 { tf.0 |= TF_HASH; }
        crate::hash::hash_aset(c, a, b, v)?;
        return Ok(v);
    }
    srb_aset_out(c, a, b, v, line, cc)
}

// ---- definitions -------------------------------------------------------------------

// Entry of a required-params-only method: frame setup with its sizes baked in.  me / block come in ca:
// from a call that compiled the entry in, or from c.call_* (CallArgs).  flags: ME_* (vm.rs), decided by the compiler.
NODE_DEF
node_method_entry(c: &mut Ctx, n: NodePtr, fp: Fp, nlocals: u32, nparams: u32, flags: u32, line: u32, body: NODE, ca@specin: CallArgs)
{
    #[cfg(feature = "nodeprof")] crate::nodeprof::hit_body("entry", n, flags & ME_ENV != 0, nparams as usize, !ca.blk.is_null());
    // nothing in a leaf body can call, raise or look at a frame
    if flags & ME_LEAF != 0 { return EVAL_ARG!(c, body); }
    let me = ca.me;
    let blk = ca.blk;
    // id 0: no block can return to this frame, and its own `return` is caught by the innermost entry
    let id = if flags & ME_ID != 0 { c.next_serial() } else { 0 };
    let mut fr = Frame { prev: c.frame, fp: head(fp), me, blk, id, line, kind: FK_METHOD, visi: VISI_PUBLIC, lite: true, pad: 0 };
    // no native stack check here: whoever calls an entry out of line makes it (run_entry, site_fast)
    // a shared frame (the caller's, CallArgs) has no slots of its own and keeps the caller's env
    if !ca.shared {
        enter(c, fp, nlocals, nparams)?;
        fp[1].set(NIL);
    }
    let mut i = 2 + nparams;
    while i < nlocals { slot(fp, i).set(NIL); i += 1; }
    if flags & ME_ENV != 0 { make_env(unsafe { &*fr.iseq() }, fp, NIL); }
    c.frame = &mut fr;
    let r = EVAL_ARG!(c, body);
    c.frame = fr.prev;
    match r {
        Ok(v) => Ok(v),
        Err(e) => if c.esc == EscKind::Return && c.esc_tag == id { c.esc = EscKind::None; Ok(c.esc_val) } else { Err(e) },
    }
}

// Entry of a block with only required params run as a plain block (run_block_fast): frame setup with
// its sizes baked in.  The Block comes in ca.blk (CallArgs), the arguments are at fp[2..], sp is at the base.
NODE_DEF
node_block_entry(c: &mut Ctx, n: NodePtr, fp: Fp, nlocals: u32, nparams: u32, flags: u32, line: u32, body: NODE, ca@specin: CallArgs)
{
    let b = unsafe { &*ca.blk };
    // iseq null: Frame::iseq() takes it from self_blk when asked
    let mut fr = FrameFull {
        h: Frame { prev: c.frame, fp: head(fp), me: b.me, blk: b.outer_blk, id: b.home_id, line, kind: FK_BLOCK, visi: VISI_PUBLIC, lite: false, pad: 0 },
        cref: b.cref, iseq: std::ptr::null(), self_blk: b, defined_class: b.defined_class,
    };
    fp[0].set(b.self_);
    fp[1].set(b.env);
    let mut i = 2 + nparams;
    while i < nlocals { slot(fp, i).set(NIL); i += 1; }
    enter_base(c, fp, nlocals)?;
    if flags & ME_ENV != 0 { make_env(unsafe { &*fr.h.iseq() }, fp, b.env); }
    c.frame = &mut fr.h;
    let mut r = EVAL_ARG!(c, body);
    // redo runs the body again out of line (a second inline copy would double the block's code)
    if r.is_err() && c.esc == EscKind::Redo { r = srb_block_redo(c, body, fp); }
    c.frame = fr.prev;
    match r {
        Ok(v) => Ok(v),
        Err(e) => if c.esc == EscKind::Next { c.esc = EscKind::None; Ok(c.esc_val) } else { Err(e) },
    }
}

NODE_DEF
node_def(c: &mut Ctx, n: NodePtr, fp: Fp, mid: Sym, body: IseqRef)
{
    srb_def(c, mid, body, fp)
}

NODE_DEF
node_sdef(c: &mut Ctx, n: NodePtr, fp: Fp, recv@child: Value, mid: Sym, body: IseqRef)
{
    srb_sdef(c, recv, mid, body)
}

NODE_DEF
node_class(c: &mut Ctx, n: NodePtr, fp: Fp, cpath: NODE, name: Sym, superclass: NODE, body: IseqRef, has_cpath: bool, has_super: bool)
{
    let outer = if has_cpath { EVAL_ARG!(c, cpath)? } else { UNDEF };
    let sup = if has_super { EVAL_ARG!(c, superclass)? } else { UNDEF };
    srb_class(c, outer, name, sup, body, fp)
}

NODE_DEF
node_module(c: &mut Ctx, n: NodePtr, fp: Fp, cpath: NODE, name: Sym, body: IseqRef, has_cpath: bool)
{
    let outer = if has_cpath { EVAL_ARG!(c, cpath)? } else { UNDEF };
    srb_module(c, outer, name, body, fp)
}

NODE_DEF
node_sclass(c: &mut Ctx, n: NodePtr, fp: Fp, recv@child: Value, body: IseqRef)
{
    srb_sclass(c, recv, body, fp)
}

NODE_DEF
node_alias(c: &mut Ctx, n: NodePtr, fp: Fp, newname@child: Value, oldname@child: Value)
{
    srb_alias(c, newname, oldname)
}

NODE_DEF
node_valias(c: &mut Ctx, n: NodePtr, fp: Fp, newname: Sym, oldname: Sym)
{
    vm().global_aliases.insert(newname, oldname);
    Ok(NIL)
}

NODE_DEF
node_undef(c: &mut Ctx, n: NodePtr, fp: Fp, names: NODES)
{
    for i in 0..EVAL_LEN!(names) {
        let v = EVAL_NTH!(c, names, i)?;
        srb_undef(c, v)?;
    }
    Ok(NIL)
}

// ---- multiple assignment -------------------------------------------------------------------

// rhs → Array stored in tmp slot; targets read it through node_masgn_elem
NODE_DEF
node_masgn(c: &mut Ctx, n: NodePtr, fp: Fp, rhs@child: Value, tmp: u32, targets: NODES, splat_rhs: bool)
{
    let a = srb_masgn_array(c, rhs, splat_rhs)?;
    slot(fp, tmp).set(a);
    for i in 0..EVAL_LEN!(targets) { EVAL_NTH!(c, targets, i)?; }
    Ok(rhs)
}

// kind: 0 = element idx (from front), 1 = splat [idx, len - post), 2 = element from back (post)
NODE_DEF
node_masgn_elem(c: &mut Ctx, n: NodePtr, fp: Fp, tmp: u32, idx: u32, kind: u32, post: u32)
{
    let a = slot(fp, tmp).get();
    Ok(srb_masgn_elem(a, idx, kind, post))
}

NODE_DEF
node_unsupported(c: &mut Ctx, n: NodePtr, fp: Fp, what: Str)
{
    srb_unsupported(c, what)
}

// the value of a method-body-level `__method__`, etc. are cfuncs; this node evaluates an
// arbitrary closure-free runtime helper by id (rarely used constructs)
NODE_DEF
node_special(c: &mut Ctx, n: NodePtr, fp: Fp, kind: u32, arg: NODE)
{
    srb_special::<D_arg>(c, n, fp, kind, arg)
}
