// astrogre match nodes (continuation-passing).  Every node takes the current position, checks
// its piece, and calls `next` with the new position.  Result: FAIL (0), OK (1), ABORT (2: the
// loop recursion budget ran out; the search is redone on the iterative VM).  A node undoes its
// own logged side effects when its continuation fails.
use super::*;
use super::cps::*;
use super::node::*;

// ---- terminals --------------------------------------------------------------------

NODE_DEF
node_re_succ(c: &mut Ctx, n: NodePtr, pos: usize) -> u32
{
    c.slots[1] = pos;
    OK
}

NODE_DEF
node_re_sub_succ(c: &mut Ctx, n: NodePtr, pos: usize) -> u32
{
    c.sub_end = pos;
    OK
}

NODE_DEF
node_re_sub_succ_at(c: &mut Ctx, n: NodePtr, pos: usize) -> u32
{
    if pos == c.lb_target { OK } else { FAIL }
}

// ---- characters -------------------------------------------------------------------

NODE_DEF
node_re_byte(c: &mut Ctx, n: NodePtr, pos: usize, b: u8, next: NODE) -> u32
{
    let s = c.subj();
    if pos < s.len() && s[pos] == b {
        let np = pos + 1;
        EVAL_ARG!(c, next, np)
    } else {
        FAIL
    }
}

NODE_DEF
node_re_lit(c: &mut Ctx, n: NodePtr, pos: usize, bytes: Bytes, next: NODE) -> u32
{
    let s = c.subj();
    let l = bytes.len();
    if s.len() - pos >= l && &s[pos..pos + l] == bytes {
        let np = pos + l;
        EVAL_ARG!(c, next, np)
    } else {
        FAIL
    }
}

NODE_DEF
node_re_one(c: &mut Ctx, n: NodePtr, pos: usize, kind: u32, ch: u32, cls: ClassRef, next: NODE) -> u32
{
    match one_k(kind, ch, cls, c.subj(), pos) {
        Some(np) => EVAL_ARG!(c, next, np),
        None => FAIL,
    }
}

NODE_DEF
node_re_grapheme(c: &mut Ctx, n: NodePtr, pos: usize, next: NODE) -> u32
{
    match grapheme_k(c, pos) {
        Some(np) => EVAL_ARG!(c, next, np),
        None => FAIL,
    }
}

// Greedy/lazy loop over a single-char matcher: iterates inside the node (no nesting).
// nb >= 0: the continuation starts with that literal byte, so only those positions are tried.
NODE_DEF
node_re_rep1(c: &mut Ctx, n: NodePtr, pos: usize, kind: u32, ch: u32, cls: ClassRef, min: u32, max: u32, greedy: bool, nb: i32, next: NODE) -> u32
{
    let s = c.subj();
    let mut p = pos;
    let mut cnt = 0u32;
    while cnt < min {
        match one_k(kind, ch, cls, s, p) {
            Some(np) => { p = np; cnt += 1; }
            None => return FAIL,
        }
    }
    if greedy {
        let minpos = p;
        let rem = if max == INF { INF } else { max - min };
        let maxpos = scan_k(kind, ch, cls, s, p, rem);
        let mut q = if nb >= 0 {
            match find_back(s, minpos, maxpos, nb as u8) { Some(q) => q, None => return FAIL }
        } else {
            maxpos
        };
        loop {
            let r = EVAL_ARG!(c, next, q);
            if r != FAIL { return r; }
            if q <= minpos { return FAIL; }
            q = if nb >= 0 {
                match find_back(s, minpos, q - 1, nb as u8) { Some(x) => x, None => return FAIL }
            } else {
                prev_start(s, q, minpos)
            };
        }
    } else {
        let (mut q, mut k) = match lazy_advance_k(kind, ch, cls, s, p, cnt, max, nb) { Some(x) => x, None => return FAIL };
        loop {
            let r = EVAL_ARG!(c, next, q);
            if r != FAIL { return r; }
            if k >= max { return FAIL; }
            let np = match one_k(kind, ch, cls, s, q) { Some(x) => x, None => return FAIL };
            match lazy_advance_k(kind, ch, cls, s, np, k + 1, max, nb) {
                Some((a, b)) => { q = a; k = b; }
                None => return FAIL,
            }
        }
    }
}

// ---- zero-width ---------------------------------------------------------------------

NODE_DEF
node_re_assert(c: &mut Ctx, n: NodePtr, pos: usize, kind: u32, next: NODE) -> u32
{
    if assert_k(kind, c, pos) { EVAL_ARG!(c, next, pos) } else { FAIL }
}

NODE_DEF
node_re_keep(c: &mut Ctx, n: NodePtr, pos: usize, next: NODE) -> u32
{
    let mark = c.log.len();
    c.set_slot(0, pos);
    let r = EVAL_ARG!(c, next, pos);
    if r == FAIL { c.undo(mark); }
    r
}

// ---- groups and backrefs ------------------------------------------------------------

// Backtrackable group start (Onigmo MEMORY_START_PUSH): logs the old span, unsets the end.
NODE_DEF
node_re_open(c: &mut Ctx, n: NodePtr, pos: usize, g: u32, next: NODE) -> u32
{
    let mark = c.log.len();
    let k = 2 * g as usize;
    c.set_slot(k, pos);
    c.set_slot(k + 1, NONE);
    let r = EVAL_ARG!(c, next, pos);
    if r == FAIL { c.undo(mark); }
    r
}

// Group start outside alternation/variable repeat/negation (Onigmo MEMORY_START): not undone.
NODE_DEF
node_re_open_nr(c: &mut Ctx, n: NodePtr, pos: usize, g: u32, next: NODE) -> u32
{
    let k = 2 * g as usize;
    c.slots[k] = pos;
    c.slots[k + 1] = NONE;
    EVAL_ARG!(c, next, pos)
}

// Group end (Onigmo MEMORY_END): never undone, so backrefs can see a stale end.
NODE_DEF
node_re_close(c: &mut Ctx, n: NodePtr, pos: usize, g: u32, next: NODE) -> u32
{
    c.slots[2 * g as usize + 1] = pos;
    EVAL_ARG!(c, next, pos)
}

NODE_DEF
node_re_backref(c: &mut Ctx, n: NodePtr, pos: usize, groups: Groups, icase: bool, next: NODE) -> u32
{
    match backref_k(c, groups, icase, pos) {
        Some(np) => {
            let mark = c.log.len();
            if np == pos && c.sprev_bug != pos { c.set_sprev(pos); }
            let r = EVAL_ARG!(c, next, np);
            if r == FAIL { c.undo(mark); }
            r
        }
        None => FAIL,
    }
}

NODE_DEF
node_re_cond(c: &mut Ctx, n: NodePtr, pos: usize, groups: Groups, yes: NODE, no: NODE) -> u32
{
    if cond_k(c, groups) { EVAL_ARG!(c, yes, pos) } else { EVAL_ARG!(c, no, pos) }
}

// ---- choice and repetition ----------------------------------------------------------

NODE_DEF
node_re_alt(c: &mut Ctx, n: NodePtr, pos: usize, a: NODE, b: NODE) -> u32
{
    let r = EVAL_ARG!(c, a, pos);
    if r != FAIL { return r; }
    EVAL_ARG!(c, b, pos)
}

// x? : `body` already ends with the continuation, `skip` is the continuation itself.
NODE_DEF
node_re_opt(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE, skip: NODE, greedy: bool) -> u32
{
    if greedy {
        let r = EVAL_ARG!(c, body, pos);
        if r != FAIL { return r; }
        EVAL_ARG!(c, skip, pos)
    } else {
        let r = EVAL_ARG!(c, skip, pos);
        if r != FAIL { return r; }
        EVAL_ARG!(c, body, pos)
    }
}

// General loop; body's tail is node_re_rep_cont.  body/outer are entered through the frame.
NODE_DEF
node_re_rep(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE, outer: NODE, min: u32, max: u32, greedy: bool, mem: bool, shape: u32, cost: u32) -> u32
{
    rep_enter(c, body, outer, min, max, greedy, mem, shape, cost, pos)
}

NODE_DEF
node_re_rep_cont(c: &mut Ctx, n: NodePtr, pos: usize) -> u32
{
    rep_cont(c, pos)
}

// Lookahead / lookbehind / atomic group: `body` ends with node_re_sub_succ(_at).
NODE_DEF
node_re_look(c: &mut Ctx, n: NodePtr, pos: usize, kind: u32, body: NODE, next: NODE, minlen: u32, maxlen: u32) -> u32
{
    let mark = c.log.len();
    if kind == LK_AHEAD || kind == LK_ATOMIC {
        let sprev0 = c.sprev_bug;
        let r = EVAL_ARG!(c, body, pos);
        if r != OK { return r; }
        // Onigmo's POP_POS restores the previous-char pointer after a lookahead.
        if kind == LK_AHEAD && c.sprev_bug != sprev0 { c.set_sprev(sprev0); }
        let np = if kind == LK_ATOMIC { c.sub_end } else { pos };
        let r = EVAL_ARG!(c, next, np);
        if r == FAIL { c.undo(mark); }
        return r;
    }
    if kind == LK_NEG_AHEAD {
        let r = EVAL_ARG!(c, body, pos);
        if r == ABORT { return r; }
        if r == OK { c.undo(mark); return FAIL; }
        return EVAL_ARG!(c, next, pos);
    }
    let s = c.subj();
    let saved = c.lb_target;
    c.lb_target = pos;
    let mut found = false;
    let mut q = pos;
    let mut k = 0u32;
    loop {
        if k >= minlen {
            let r = EVAL_ARG!(c, body, q);
            if r == ABORT { c.lb_target = saved; return r; }
            if r == OK { found = true; break; }
        }
        if k >= maxlen || q == 0 { break; }
        q = prev_start(s, q, 0);
        k += 1;
    }
    c.lb_target = saved;
    if kind == LK_BEHIND {
        if !found { return FAIL; }
        let r = EVAL_ARG!(c, next, pos);
        if r == FAIL { c.undo(mark); }
        r
    } else {
        if found { c.undo(mark); return FAIL; }
        EVAL_ARG!(c, next, pos)
    }
}

// ---- scanners: the search loop as a node, so it fuses with the pattern under AOT -----------
// `pos` is the search start; each candidate resets the per-attempt state.  A match starting
// at p must contain the required literals at or after p (c.must_next / Ctx::must_refresh).

NODE_DEF
node_search(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE, anchor: u32) -> u32
{
    let s = c.subj();
    let len = s.len();
    let start = pos;
    let mut p = pos;
    loop {
        if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        if anchor == AN_STR_BEGIN {
            if p != 0 { return FAIL; }
        } else if anchor == AN_START {
            if p != start { return FAIL; }
        } else if anchor == AN_LINE && p != start && s[p - 1] != b'\n' {
            match memchr_from(s, b'\n', p) { Some(k) => p = k + 1, None => return FAIL }
            if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        }
        c.reset(p);
        let r = EVAL_ARG!(c, body, p);
        if r != FAIL { return r; }
        if p >= len { return FAIL; }
        p += char_len(s, p);
    }
}

NODE_DEF
node_search_memchr(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE, b: u8) -> u32
{
    let s = c.subj();
    let mut p = pos;
    loop {
        if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        match memchr_from(s, b, p) { Some(q) => p = q, None => return FAIL }
        if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        c.reset(p);
        let r = EVAL_ARG!(c, body, p);
        if r != FAIL { return r; }
        p += char_len(s, p);
    }
}

NODE_DEF
node_search_memmem(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE, needle: Bytes) -> u32
{
    let s = c.subj();
    let mut p = pos;
    loop {
        if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        match find_from(s, needle, p) { Some(q) => p = q, None => return FAIL }
        if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        c.reset(p);
        let r = EVAL_ARG!(c, body, p);
        if r != FAIL { return r; }
        p += char_len(s, p);
    }
}

NODE_DEF
node_search_byteset(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE, set: ByteSet) -> u32
{
    let s = c.subj();
    let len = s.len();
    let fs = unsafe { &*set };
    let mut p = pos;
    loop {
        if p > c.must_next && !c.must_refresh(p) { return FAIL; }
        while p < len && !fs[s[p] as usize] { p += char_len(s, p); }
        if p >= len || (p > c.must_next && !c.must_refresh(p)) { return FAIL; }
        c.reset(p);
        let r = EVAL_ARG!(c, body, p);
        if r != FAIL { return r; }
        p += char_len(s, p);
    }
}

NODE_DEF
node_match_at(c: &mut Ctx, n: NodePtr, pos: usize, body: NODE) -> u32
{
    c.reset(pos);
    EVAL_ARG!(c, body, pos)
}
